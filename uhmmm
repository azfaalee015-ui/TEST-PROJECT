<body>

<h1>test-test</h1>
<p id="changethetext" >the text would change here.</p>
<button onclick="changeitnow()" >click here to change the text!</button>
<script>
function changeitnow() {
alert("text is change now congrat!");
document.getElementById("changethetext").innerText="Hello JS";}
</script>

<img id="maimage" src="https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/391540/header.jpg?t=1757349115">

<button id="thebuttonthatwillswaptheimages">swap the image</button>

<script>
let swapimg = true;

document.getElementById("thebuttonthatwillswaptheimages").addEventListener("dblclick", function() {
const img = document.getElementById("maimage");

if (swapimg) {
img.src = "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1671210/7ccda5b1631d2e60cc756a3271e845dbb9168821/header.jpg?t=1782314340";
} else {
img.src = "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/391540/header.jpg?t=1757349115";
}

swapimg = !swapimg;
});
</script>

